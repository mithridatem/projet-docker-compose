# Connexion du serveur Node a Redis
REDIS_URL=redis://redis:6379

# Proxy de developpement Vite vers l'API dans le meme conteneur
API_DEV_URL=http://127.0.0.1:4000

# Proxy Nginx vers le service Node du reseau Docker
API_URL=http://node:4000

# Point d'entree unique et domaines de la V3
HTTP_PORT=8080
DEV_HOST=dev.localhost
PROD_HOST=prod.localhost

# Proxy Nginx vers Vite (port interne uniquement)
VITE_URL=http://node:3000
